# Copie este arquivo para ".env" (ignorado pelo Git) e preencha os valores.
# A API le este arquivo automaticamente ao iniciar; o docker-compose tambem o utiliza.

# Banco de dados
DB_URL=jdbc:mysql://localhost:3306/match_v2
DB_USERNAME=root
DB_PASSWORD=

# Segredo de assinatura dos tokens JWT (obrigatorio, minimo de 32 caracteres).
# Gere um valor aleatorio, por exemplo: openssl rand -base64 48
API_SECURITY_TOKEN_SECRET=

# Opcionais
# API_SECURITY_TOKEN_EXPIRATION_HOURS=1
# JPA_SHOW_SQL=false
# REBEC_IMPORT_ON_STARTUP=true
# REBEC_IMPORT_CRON=0 0 0 * * SUN
# REBEC_XML_URL=https://raw.githubusercontent.com/CaioBindella/REBEC-MATCH/refs/heads/xml/RBR-ictrp-ALL.xml
