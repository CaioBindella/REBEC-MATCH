{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs", // Define o sistema de módulos para CommonJS
    "moduleResolution": "node", // Define como os módulos são encontrados
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}